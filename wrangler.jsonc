{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindbliss-portal",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "cache": { "enabled": false },
  "assets": {
    "directory": ".open-next/assets", "binding": "ASSETS",
    "html_handling": "none", "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*", "!/fonts/*", "!/mindbliss/*"]
  },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": false },
  "vars": { "CLOUDFLARE_DEPLOYMENT_READY": "false", "MEMBER_DB_PROVIDER": "hyperdrive", "MEMBER_DB_QUERY_CACHE_DISABLED": "false", "AUTH_PROVIDER": "better-auth", "BETTER_AUTH_BACKEND_URL": "https://auth.core.internal", "VP_PAYMENTS_URL": "https://payments.core.internal", "VP_WITHDRAWALS_URL": "https://withdrawals.core.internal", "STRIPE_CHECKOUT_ENABLED": "false", "NOWPAYMENTS_MEMBERSHIPS_ENABLED": "false", "NOWPAYMENTS_WEBHOOK_ENABLED": "false", "RESEND_WEBHOOK_ENABLED": "false" },
  "env": {
    "staging": {
      "name": "mindbliss-portal-staging",
      "workers_dev": false, "preview_urls": false,
      "routes": [],
      "vars": { "CLOUDFLARE_DEPLOYMENT_READY": "false", "MEMBER_DB_PROVIDER": "hyperdrive", "MEMBER_DB_QUERY_CACHE_DISABLED": "false", "AUTH_PROVIDER": "better-auth", "BETTER_AUTH_BACKEND_URL": "https://auth.core.internal", "VP_PAYMENTS_URL": "https://payments.core.internal", "VP_WITHDRAWALS_URL": "https://withdrawals.core.internal", "STRIPE_CHECKOUT_ENABLED": "false", "NOWPAYMENTS_MEMBERSHIPS_ENABLED": "false", "NOWPAYMENTS_WEBHOOK_ENABLED": "false", "RESEND_WEBHOOK_ENABLED": "false" },
      "services": [{ "binding": "CORE_API", "service": "mindbliss-core-staging" }, { "binding": "CORE_EMAIL_TELEMETRY", "service": "mindbliss-core-staging", "entrypoint": "PrivateEmailTelemetry" }]
    },
    "production": {
      "name": "mindbliss-portal-production",
      "workers_dev": false, "preview_urls": false,
      "routes": [{ "pattern": "mindblisspower.com", "custom_domain": true }],
      "vars": { "CLOUDFLARE_DEPLOYMENT_READY": "true", "MEMBER_DB_PROVIDER": "hyperdrive", "MEMBER_DB_QUERY_CACHE_DISABLED": "true", "AUTH_PROVIDER": "better-auth", "AUTH_PUBLIC_ORIGIN": "https://mindblisspower.com", "BETTER_AUTH_BACKEND_URL": "https://auth.core.internal", "VP_PAYMENTS_URL": "https://payments.core.internal", "VP_WITHDRAWALS_URL": "https://withdrawals.core.internal", "STRIPE_CHECKOUT_ENABLED": "false", "NOWPAYMENTS_MEMBERSHIPS_ENABLED": "true", "NOWPAYMENTS_WEBHOOK_ENABLED": "true", "RESEND_WEBHOOK_ENABLED": "true", "RESEND_TRACE_ENABLED": "true" },
      "hyperdrive": [{ "binding": "HYPERDRIVE_MEMBER_FRESH", "id": "fea27e02187448dd940393bc63f4eda6" }],
      "services": [{ "binding": "CORE_API", "service": "mindbliss-core-production" }, { "binding": "CORE_EMAIL_TELEMETRY", "service": "mindbliss-core-production", "entrypoint": "PrivateEmailTelemetry" }]
    },
    "rewon": {
      "name": "mindbliss-portal-rewon",
      "workers_dev": true, "preview_urls": false,
      "routes": [{ "pattern": "app.mindblisspower.com", "custom_domain": true }],
      "vars": { "CLOUDFLARE_DEPLOYMENT_READY": "true", "MEMBER_DB_PROVIDER": "hyperdrive", "MEMBER_DB_QUERY_CACHE_DISABLED": "true", "AUTH_PROVIDER": "better-auth", "AUTH_SOCIAL_PROVIDERS": "google", "AUTH_PUBLIC_ORIGIN": "https://app.mindblisspower.com", "AUTH_ALTERNATE_ORIGIN": "https://mindbliss-portal-rewon.devfidubit.workers.dev", "BETTER_AUTH_BACKEND_URL": "https://auth.core.internal", "VP_PAYMENTS_URL": "https://payments.core.internal", "VP_WITHDRAWALS_URL": "https://withdrawals.core.internal", "STRIPE_CHECKOUT_ENABLED": "false", "NOWPAYMENTS_MEMBERSHIPS_ENABLED": "true", "NOWPAYMENTS_WEBHOOK_ENABLED": "false", "RESEND_WEBHOOK_ENABLED": "false", "RESEND_TRACE_ENABLED": "false" },
      "hyperdrive": [{ "binding": "HYPERDRIVE_MEMBER_FRESH", "id": "fea27e02187448dd940393bc63f4eda6" }],
      "services": [{ "binding": "CORE_API", "service": "mindbliss-core-production" }]
    }
  }
}
