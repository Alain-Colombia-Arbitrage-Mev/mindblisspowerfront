{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindbliss-wallet",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": false
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/fonts/*",
      "!/mindbliss/*"
    ]
  },
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "CLOUDFLARE_DEPLOYMENT_READY": "false",
    "MEMBER_DB_PROVIDER": "hyperdrive",
    "MEMBER_DB_QUERY_CACHE_DISABLED": "false",
    "AUTH_PROVIDER": "better-auth",
    "BETTER_AUTH_BACKEND_URL": "https://auth.core.internal",
    "VP_PAYMENTS_URL": "https://payments.core.internal",
    "VP_WITHDRAWALS_URL": "https://withdrawals.core.internal",
    "STRIPE_CHECKOUT_ENABLED": "false",
    "NOWPAYMENTS_MEMBERSHIPS_ENABLED": "false",
    "NOWPAYMENTS_WEBHOOK_ENABLED": "false",
    "RESEND_WEBHOOK_ENABLED": "false"
  },
  "env": {
    "staging": {
      "name": "mindbliss-wallet-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "CLOUDFLARE_DEPLOYMENT_READY": "false",
        "MEMBER_DB_PROVIDER": "hyperdrive",
        "MEMBER_DB_QUERY_CACHE_DISABLED": "false",
        "AUTH_PROVIDER": "better-auth",
        "BETTER_AUTH_BACKEND_URL": "https://auth.core.internal",
        "VP_PAYMENTS_URL": "https://payments.core.internal",
        "VP_WITHDRAWALS_URL": "https://withdrawals.core.internal",
        "STRIPE_CHECKOUT_ENABLED": "false",
        "NOWPAYMENTS_MEMBERSHIPS_ENABLED": "false",
        "NOWPAYMENTS_WEBHOOK_ENABLED": "false",
        "RESEND_WEBHOOK_ENABLED": "false"
      },
      "services": [
        {
          "binding": "CORE_API",
          "service": "mindbliss-core-staging"
        },
        {
          "binding": "CORE_EMAIL_TELEMETRY",
          "service": "mindbliss-core-staging",
          "entrypoint": "PrivateEmailTelemetry"
        }
      ]
    },
    "wallet": {
      "name": "mindbliss-wallet",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "wallet.mindblisspower.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "CLOUDFLARE_DEPLOYMENT_READY": "true",
        "MEMBER_DB_PROVIDER": "hyperdrive",
        "MEMBER_DB_QUERY_CACHE_DISABLED": "true",
        "AUTH_PROVIDER": "better-auth",
        "AUTH_SOCIAL_PROVIDERS": "",
        "AUTH_PUBLIC_ORIGIN": "https://wallet.mindblisspower.com",
        "BETTER_AUTH_BACKEND_URL": "https://auth.core.internal",
        "VP_PAYMENTS_URL": "https://payments.core.internal",
        "VP_WITHDRAWALS_URL": "https://withdrawals.core.internal",
        "STRIPE_CHECKOUT_ENABLED": "false",
        "NOWPAYMENTS_MEMBERSHIPS_ENABLED": "false",
        "NOWPAYMENTS_WEBHOOK_ENABLED": "false",
        "RESEND_WEBHOOK_ENABLED": "false",
        "RESEND_TRACE_ENABLED": "false",
        "ADMINISTRATIVE_ONRAMP_ENVIRONMENT": "sandbox"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE_MEMBER_FRESH",
          "id": "fea27e02187448dd940393bc63f4eda6"
        }
      ],
      "services": [
        {
          "binding": "CORE_API",
          "service": "mindbliss-core-production"
        },
        {
          "binding": "WALLET_CORE",
          "service": "mindbliss-wallet-core"
        }
      ]
    }
  }
}
