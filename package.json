  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:bundle": "opennextjs-cloudflare build",
    "cf:build": "docker build -f Dockerfile.cloudflare --target worker-artifacts --output type=local,dest=.open-next .",
    "cf:types": "wrangler types --env staging --env-interface CloudflareEnv",
    "cf:dry-run": "wrangler deploy --env staging --dry-run --outdir .wrangler/dry-run",
    "cf:smoke": "docker build -f Dockerfile.cloudflare --target worker-build -t mindbliss/portal-worker-test:local . && docker run --rm --network none --read-only --tmpfs /tmp --tmpfs /app/.wrangler mindbliss/portal-worker-test:local node scripts/cloudflare-smoke.mjs",
    "test": "node --test \"src/**/*.test.mjs\"",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json --noEmit"
  },
