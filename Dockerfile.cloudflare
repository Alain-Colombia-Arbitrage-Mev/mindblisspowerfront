# syntax=docker/dockerfile:1.7
# Local-only Linux build. No source .env, credentials, DNS or remote resources.
FROM node:24.16.0-bookworm-slim@sha256:2c87ef9bd3c6a3bd4b472b4bec2ce9d16354b0c574f736c476489d09f560a203 AS dependencies
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 CI=1
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=mindbliss-portal-cf-npm,target=/root/.npm,sharing=locked npm ci --ignore-scripts --no-audit --no-fund

FROM dependencies AS worker-build
RUN apt-get update && apt-get install --no-install-recommends -y ca-certificates
COPY src ./src
COPY public ./public
COPY next.config.mjs postcss.config.js tailwind.config.js jsconfig.json ./
COPY open-next.config.ts wrangler.jsonc cloudflare-worker.mjs ./
COPY scripts/prepare-static-cache-headers.mjs ./scripts/prepare-static-cache-headers.mjs
# Node middleware is unsupported by OpenNext. The custom Worker applies the
# same pure policies and matcher; Node/Docker's original proxy stays untouched.
RUN rm /app/src/proxy.js
RUN npm run cf:bundle
RUN node scripts/prepare-static-cache-headers.mjs
RUN npx wrangler deploy --env staging --dry-run --outdir /tmp/worker-dry-run
COPY cloudflare-smoke-worker.mjs ./
COPY scripts/cloudflare-smoke.mjs ./scripts/cloudflare-smoke.mjs

FROM scratch AS worker-artifacts
COPY --from=worker-build /app/.open-next/ /
